# CS Helper 服务端环境变量（systemd 的 EnvironmentFile 不支持 export 和引号）
# 改完执行：sudo systemctl restart cs-helper

# 令牌签名密钥。留空会每次启动随机生成 —— 那样重启后手机/电脑都要重新进房，
# 所以安装脚本会写一个固定的随机值进来。
CS_HELPER_SERVER_SECRET=change-me

# 上报密钥：设了之后只有带着这个密钥的桌面端才能写数据（手机端只看不传，不受影响）。
# 留空 = 不校验，适合纯局域网自用。设了就必须在桌面端「设置 → 小队协同 → 上报密钥」填一致，
# 否则上报会被 403 拒绝（对局不会出现在房间里）。
CS_HELPER_REPORT_KEY=

# 房间模式：single = 固定一个房间码（自用推荐），multi = 允许建房
CS_HELPER_ROOM_MODE=single
CS_HELPER_SINGLE_ROOM_CODE=MAIN

# 数据目录（会话、产物、demo 缓存）。systemd 的 StateDirectory 会建好 /var/lib/cs-helper
CS_HELPER_DATA_DIR=/var/lib/cs-helper/data
CS_HELPER_WORK_DIR=/var/lib/cs-helper/jobs
CS_HELPER_DEMO_DIR=/var/lib/cs-helper/demos

# AI 分析（任何 OpenAI 兼容端点；不填就跳过分析任务，其它功能照常）
CS_HELPER_AI_BASE_URL=https://api.deepseek.com/v1
CS_HELPER_AI_MODEL=deepseek-flash
CS_HELPER_AI_KEY=

# 每个对手下载几场 demo（1 场约 200-400MB，5 个对手 ≈ 1-2GB/局）
CS_HELPER_DEMO_MAX_DEMOS=1

# 常规管线的下载并发（默认 3；线路好可以调到 4-5）
CS_SCOUT_NORMAL_DOWNLOAD_WORKERS=3

# 生产环境保持关闭：/api/v1/dev/* 会读本机任意 .dem
CS_HELPER_DEV=
